alias adb="~/genymotion/tools/adb"
alias jadx="~/Documents/jadx/bin/jadx"
alias jadx-gui="~/Documents/jadx/bin/jadx-gui"
alias minecraft="~/minecraft/minecraft-launcher/minecraft-launcher"
